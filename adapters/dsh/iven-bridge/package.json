{
  "name": "iven-bridge",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Iven pet for DSH: session status, in-app overlay and standalone desktop handoff",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-slots"]
    }
  }
}
